# Ready-made settings for XAMPP on Windows (MySQL/MariaDB on port 3306, user root, EMPTY password).
# setup-windows.bat copies this to .env.local. Local development only — contains no real secrets.
APP_ENV=development
APP_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dujon
DB_SSL=false
DB_POOL_LIMIT=3
MAIL_DRIVER=file
MAIL_FROM=DUJON <no-reply@dujon.invalid>
OPS_EMAIL=ops@example.invalid
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/photos
CRON_SECRET=local-dev-cron-secret-change-me-1234567890
RATE_LIMIT_SALT=local-dev-salt-change-me-1234567890
OPS_ACTOR=local
