# Copy to .env.local and fill in. Never commit real values. (docs/12 §4)

# App
APP_ENV=development                 # development | preview | production
APP_URL=http://localhost:3000

# Database (added in Milestone 3)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dujon_app
DB_PASSWORD=<placeholder>
DB_NAME=dujon_dev
DB_SSL=false
DB_SSL_CA=
DB_POOL_LIMIT=3
MIGRATION_DATABASE_URL=mysql://dujon_migrate:<placeholder>@127.0.0.1:3306/dujon_dev

# Email (Milestone 3)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DUJON <no-reply@example.com>"
OPS_EMAIL=<ops-inbox@example.com>

# Object storage (Milestone 7)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=<placeholder>
S3_SECRET_ACCESS_KEY=<placeholder>
S3_BUCKET=dujon-photos-dev

# Security
CRON_SECRET=<32+ random bytes>
RATE_LIMIT_SALT=<32+ random bytes>

# --- added in the build milestones (no real values here) ---
MAIL_DRIVER=file            # file (dev) | smtp (production)
MAIL_FROM="DUJON <no-reply@example.com>"
OPS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
STORAGE_DRIVER=local        # local (dev) | s3 (R2/S3 in production)
STORAGE_LOCAL_DIR=.data/photos
CRON_SECRET=                # Vercel cron sends it as a Bearer token
RATE_LIMIT_SALT=
OPS_ACTOR=
LEGAL_CONTENT_REVIEWED=false  # set true only after a lawyer approves terms/privacy
